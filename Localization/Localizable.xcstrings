            "value" : "Save"
          }
        }
      }
    },
    "Kazandığın Işık" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light you earned"
          }
        }
      }
    },
    "Kendine bir ödül belirle, örneğin “10 saat odaklanınca yeni bir kitap alacağım” ya da “7 gün üst üste odaklanınca kahvaltıya çıkacağım”. Derin ilerlemeni takip eder ve hedefe ulaştığında seninle kutlar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set yourself a reward, like “I'll buy a new book after 10 hours of focus” or “I'll go out for brunch after focusing 7 days in a row”. Derin keeps track of your progress and celebrates with you when you get there."
          }
        }
      }
    },
    "Kendine sözler" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promises to yourself"
          }
