    "Zenit'e geç" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upgrade to Zenith"
          }
        }
      }
    },
    "Zenit, gökyüzünün en tepesi demek. Odaklanmak, yıldızlar ve Işık her zaman ücretsiz kalır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zenith is the highest point of the sky. Focusing, stars and Light always stay free."
          }
        }
      }
    },
    "Zenit, gökyüzünün en tepesi demek. Odaklanmak, yıldızlar ve Işık her zaman ücretsiz kalır. Zenit ise bütün sesleri ve gök temalarını, ayrıntılı istatistikleri ve sınırsız kendine sözü açar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zenith is the highest point of the sky. Focusing, stars and Light always stay free. Zenith opens every sound and sky theme, detailed statistics and unlimited promises to yourself."
          }
        }
      }
    },
    "Zirve %@ · %@ yönü" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peaks %@ · look toward %@"
          }
        }
      }
    },
    "Zirve gecesi Ay %%%lld dolu olacak; sönük meteorlar ay ışığında kaybolabilir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Moon will be %lld%% full on the peak night; faint meteors may be lost in its light."
          }
        }
      }
    },
    "Zirve gecesi Ay yalnızca %%%lld dolu olacak, bu yüzden gökyüzü karanlık olur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Moon will be only %lld%% full on the peak night, so the sky will be dark."
          }
        }
      }
    },
    "Zirve gecesi için hatırlat" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remind me on the peak night"
          }
        }
      }
    },
    "Zirve gecesinde (%@) her oturumda %%25 ihtimalle bir kayan yıldız düşer ve o oturumda kazandığın Işık iki katına çıkar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the peak night (%@), every session has a 25%% chance of catching a shooting star, which doubles the Light you earn in it."
          }
        }
      }
    },
