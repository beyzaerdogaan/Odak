        }
      }
    },
    "Ücretsiz sürümde aynı anda %lld söz tutabilirsin. Zenit ile istediğin kadar söz verebilirsin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the free version you can keep %lld promises at a time. With Zenith, make as many as you like."
          }
        }
      }
    },
    "İlerleme" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress"
          }
        }
      }
    },
    "İlerlemen hesabında saklı kalır ve bu telefondan kaldırılır. Tekrar giriş yapınca geri gelir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your progress stays safe in your account and is removed from this phone. It comes back when you sign in again."
          }
        }
      }
    },
    "İlk girişte hesabın oluşturulur. Bu telefondaki ilerlemen hesabına eklenir, hiçbir şey silinmez." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account is created the first time you sign in. Progress on this phone is added to it, and nothing is deleted."
          }
        }
      }
    },
    "İlk keşfin seni bekliyor" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your first discovery awaits"
          }
        }
      }
    },
    "İlk yıldızını yakmaya hazır mısın?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ready to light your first star?"
          }
        }
      }
    },
    "İngilizce kelime" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocabulary"
          }
        }
      }
    },
    "İnternet bağlantısı yok gibi. Bağlanınca tekrar dene." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There seems to be no internet connection. Try again once you're online."
          }
        }
      }
    },
    "İstatistik ödevi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistics homework"
          }
        }
      }
    },
    "İyi akşamlar" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good evening"
          }
        }
      }
    },
    "İyi günler" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good afternoon"
          }
        }
      }
    },
    "İzin gerekli" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission needed"
          }
        }
      }
    },
    "İzin verilen kişilere Favoriler'i ekle, böylece acil durumda sana ulaşabilirler." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your Favorites to the allowed people, so they can reach you in an emergency."
          }
        }
      }
    },
    "Şafak uygulama ikonu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawn app icon"
          }
        }
      }
    },
    "Şehir ışıklarından uzaklaş, gözlerinin karanlığa alışması için 10–15 dakika bekle ve ekranın parlaklığını kıs." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get away from city lights, give your eyes 10–15 minutes to adjust to the dark, and turn your screen brightness down."
          }
        }
      }
    },
    "Şimdi vazgeçersen gökyüzünde iz kalmaz." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you give up now, the sky keeps no trace."
          }
        }
      }
    },
    "Şimdilik geç" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip for now"
          }
        }
      }
    },
    "Şu an sürüyor, zirvesi %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under way now, peaking %@."
          }
        }
      }
    },
    "“%@” müzik listelerine eklendi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” was added to your music"
          }
        }
      }
    },
    "“Tümü” modunda bile açık kalmasını istediğin uygulamaları seç, örneğin Spotify'ı." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the apps that should stay open even in “All” mode, such as Spotify."
          }
        }
