        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is a bright star, so it only falls in a session of 60 minutes or more, or in strict mode."
          }
        }
      }
    },
    "%@ parlak, 60 dakikalık bir oturumda, katı modda ya da biletle 45 dakikada düşecek" : {
