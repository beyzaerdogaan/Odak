              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld minutes left"
                }
              }
            }
          }
        }
      }
    },
    "Kalan yıldızların hepsi parlak, bu yüzden en az 60 dakikalık bir oturum ya da katı mod gerekiyor. Üst üste 4 oturumda yıldız düşmezse sıradaki oturumda yıldız garanti." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All the stars left are bright ones, so they need a session of at least 60 minutes or strict mode. If 4 sessions in a row bring no star, the next one is sure to."
          }
        }
      }
    },
    "Kapat" : {
