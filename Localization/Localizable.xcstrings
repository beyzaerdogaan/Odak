    "Kestirmeler" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcuts"
          }
        }
      }
    },
    "Kestirmeler uygulamasında “Derin Başlat” adında bir kestirme oluştur. İçine “Odağı Ayarla” eylemini ekle, Odak olarak Derin'i seç ve Açık konumuna getir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the Shortcuts app, create a shortcut named “Start Derin”. Add the “Set Focus” action to it, choose Derin as the Focus and turn it On."
          }
        }
      }
    },
