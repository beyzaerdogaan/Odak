        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On summer evenings it appears just above the southern horizon."
          }
        }
      }
    },
    "Yaz akşamları güney ufkunun üstünde, Akrep'in solunda görülür." : {
