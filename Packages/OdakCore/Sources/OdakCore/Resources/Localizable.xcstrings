            "value" : "Sagittarius"
          }
        }
      }
    },
    "Yaz akşamları başucuna bak ve mavi-beyaz Vega'yı ara." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On summer evenings, look straight up and search for blue-white Vega."
          }
