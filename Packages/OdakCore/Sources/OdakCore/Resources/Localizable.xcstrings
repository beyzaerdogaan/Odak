{
  "sourceLanguage" : "tr",
  "strings" : {
    "%@ gecesi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "on the night of %@"
          }
        }
      }
    },
    "%@ meteor yağmuru" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ meteor shower"
          }
        }
      }
    },
    "%@ takımyıldızını tamamladıktan sonra %lld dakikalık bir oturumla açılır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens with a %2$lld-minute session once you have completed %1$@."
          }
        }
      }
    },
    "%@ takımyıldızını tamamlayınca açılır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens once you complete %@."
          }
        }
      }
    },
    "%@, gece" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, at night"
          }
        }
      }
    },
    "%@, gün batımından sonra" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, after sunset"
          }
        }
      }
    },
    "%@, şafaktan önce" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, before dawn"
          }
        }
      }
    },
    "%lld / %lld gün" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld days"
          }
        }
      }
    },
    "%lld / %lld sa" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld h"
          }
        }
      }
    },
    "%lld oturum tamamlayınca açılır." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Opens once you complete %lld session."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Opens once you complete %lld sessions."
                }
              }
            }
          }
        }
      }
    },
    "21–22 Ekim civarı" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "around October 21–22"
          }
        }
      }
    },
    "22.00 ile 04.00 arasında bir oturum bitir" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish a session between 10 PM and 4 AM"
          }
        }
      }
    },
    "300 Işık" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "300 Light"
          }
        }
      }
    },
    "7 gün seri" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7-day streak"
          }
        }
      }
    },
    "7 gün üst üste odaklan" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus 7 days in a row"
          }
        }
      }
    },
    "90 dakikalık bir oturumu bitir" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish a 90-minute session"
          }
        }
      }
    },
    "90 dk maraton" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90-min marathon"
          }
        }
      }
    },
    "Adını mitolojideki güzelliğiyle övünen kraliçeden alır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is named after the queen of myth who boasted of her beauty."
          }
        }
      }
    },
    "Akrep" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorpius"
          }
        }
      }
    },
    "Akşamdan itibaren izlenebilir ama en iyi zaman gece yarısı civarıdır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can watch from the evening on, but the best time is around midnight."
          }
        }
      }
    },
    "Alacakaranlık göğü" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twilight sky"
          }
        }
      }
    },
    "Albireo küçük bir teleskopla altın ve mavi iki yıldıza ayrılır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A small telescope splits Albireo into two stars, one gold and one blue."
          }
        }
      }
    },
    "Aldebaran'ın çevresindeki V şekli Hyadlar kümesidir. Aldebaran ise bu kümenin önünde durur ve bize daha yakındır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The V around Aldebaran is the Hyades cluster. Aldebaran itself sits in front of it, much closer to us."
          }
        }
      }
    },
    "Aldebaran, Boğa'nın kırmızımsı gözünü oluşturur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldebaran is the Bull's reddish eye."
          }
        }
      }
    },
    "Alfa Centauri" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alpha Centauri"
          }
        }
      }
    },
    "Algol'ün parlaklığı yaklaşık üç günde bir belirgin şekilde düşer, çünkü yörüngedeki eşi önünden geçer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algol dims noticeably about every three days, as its orbiting companion passes in front of it."
          }
        }
      }
    },
    "Almach küçük bir teleskopla turuncu ve mavi iki yıldıza ayrılır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A small telescope splits Almach into two stars, one orange and one blue."
          }
        }
      }
    },
    "Alpheratz, Pegasus'un Büyük Karesi'nin bir köşesini de oluşturur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alpheratz also forms one corner of the Great Square of Pegasus."
          }
        }
      }
    },
    "Altair çok hızlı döndüğü için ekvatoru belirgin şekilde şişkindir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altair spins so fast that its equator bulges noticeably."
          }
        }
      }
    },
    "Altair, Yaz Üçgeni'nin üç yıldızından biridir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altair is one of the three stars of the Summer Triangle."
          }
        }
      }
    },
    "Ana yıldızları bir çaydanlığa benzer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its main stars look like a teapot."
          }
        }
      }
    },
    "Andromeda" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andromeda"
          }
        }
      }
    },
    "Andromeda Galaksisi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andromeda Galaxy"
          }
        }
      }
    },
    "Antares'in adı “Mars'ın rakibi” anlamına gelir; kırmızı rengi Mars'a benzer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antares means “rival of Mars”; its red glow resembles the planet."
          }
        }
      }
    },
    "Antares, Güneş'ten yüzlerce kat büyük bir kırmızı süperdevdir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antares is a red supergiant hundreds of times larger than the Sun."
          }
        }
      }
    },
    "Aralık ortası" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "in mid-December"
          }
        }
      }
    },
    "Aralıktaki Geminid meteor yağmuru bu yönden geliyor gibi görünür." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "December's Geminid meteor shower seems to come from this direction."
          }
        }
      }
    },
    "Arcturus turuncu renkli bir dev yıldızdır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcturus is an orange giant star."
          }
        }
      }
    },
    "Arcturus, kuzey gökyüzünün en parlak yıldızıdır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcturus is the brightest star in the northern sky."
          }
        }
      }
    },
    "Aslan" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leo"
          }
        }
      }
    },
    "Aslan takımyıldızı yükseldikten sonra, gece yarısından şafağa kadar izleyebilirsin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once Leo has risen, you can watch from midnight until dawn."
          }
        }
      }
    },
    "Aslan'ın başı ters bir soru işaretine benzer, buna “Orak” denir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Lion's head looks like a backward question mark, known as the “Sickle”."
          }
        }
      }
    },
    "Avcı" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orion"
          }
        }
      }
    },
    "Avcı Bulutsusu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orion Nebula"
          }
        }
      }
    },
    "Ay" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moon"
          }
        }
      }
    },
    "Ağustos ortası" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "in mid-August"
          }
        }
      }
    },
    "Ağustostaki Perseid meteor yağmuru bu yönden geliyor gibi görünür." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "August's Perseid meteor shower seems to come from this direction."
          }
        }
      }
    },
    "Bahar akşamları güney gökyüzünde, yüksekte görülür." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On spring evenings it rides high in the southern sky."
          }
        }
      }
    },
    "Bahar ve yaz akşamları Büyük Ayı'nın kuyruğunun ucundan aşağı doğru bak." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On spring and summer evenings, look down from the tip of Ursa Major's tail."
          }
        }
      }
    },
    "Betelgeuse turuncu-kırmızı bir süperdevdir. Rigel ise mavi-beyaz renktedir ve takımyıldızın en parlak yıldızıdır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betelgeuse is an orange-red supergiant. Rigel is blue-white and the brightest star in the constellation."
          }
        }
      }
    },
    "Bir meteor yağmuru boyunca 10 oturum tamamla" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete 10 sessions during a meteor shower"
          }
        }
      }
    },
    "Bir parlak yıldızı 45 dakikalık bir oturumda düşürür" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brings down a bright star in a 45-minute session"
          }
        }
      }
    },
    "Boğa" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taurus"
          }
        }
      }
    },
    "Bugün gördüğümüz ışığı yaklaşık 2,5 milyon yıl önce yola çıktı." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The light we see from it today set out about 2.5 million years ago."
          }
        }
      }
    },
    "Bulutsu göğü" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebula sky"
          }
        }
      }
    },
    "Büyük Ayı" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ursa Major"
          }
        }
      }
    },
    "Büyük Ayı'nın kuyruğundaki kavisi takip edersen Arcturus'a varırsın." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow the arc of Ursa Major's tail and you arrive at Arcturus."
          }
        }
      }
    },
    "Castor ve Pollux, adını mitolojideki ikiz kardeşlerden alır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Castor and Pollux are named after the twin brothers of myth."
          }
        }
      }
    },
    "Dalga" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waves"
          }
        }
      }
    },
    "Deneb, Vega ve Altair ile birlikte “Yaz Üçgeni”ni oluşturur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deneb forms the “Summer Triangle” together with Vega and Altair."
          }
        }
      }
    },
    "Dere" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream"
          }
        }
      }
    },
    "Dört yıldızı “Pegasus'un Büyük Karesi”ni oluşturur. Bu yıldızlardan biri aslında Andromeda'ya ait olan Alpheratz'dır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four of its stars form the “Great Square of Pegasus”. One of them, Alpheratz, actually belongs to Andromeda."
          }
        }
      }
    },
    "Dünya'nın ekseni yavaşça yalpaladığı için binlerce yıl sonra Vega kutup yıldızı olacak." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because Earth's axis slowly wobbles, Vega will be the pole star thousands of years from now."
          }
        }
      }
    },
    "En fazla 3 tane taşıyabilirsin" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can carry up to 3"
          }
        }
      }
    },
    "En parlak yedi yıldızı “Büyük Kepçe” olarak bilinir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its seven brightest stars are known as the “Big Dipper”."
          }
        }
      }
    },
    "Enif kanatlı atın burnunu temsil eder." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enif marks the winged horse's nose."
          }
        }
      }
    },
    "Gece" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night"
          }
        }
      }
    },
    "Gece gökyüzünün en parlak yıldızıdır ve yanında sönük bir beyaz cüce eşi vardır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The brightest star in the night sky, with a faint white dwarf companion at its side."
          }
        }
      }
    },
    "Gece kuşu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night owl"
          }
        }
      }
    },
    "Geminidler (İkizler)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geminids"
          }
        }
      }
    },
    "Gökyüzünde belirgin bir W ya da M harfi çizer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It draws a clear W or M across the sky."
          }
        }
      }
    },
    "Güneş'e en yakın yıldız sistemidir. Üç yıldızından biri olan Proxima, bize en yakın yıldızdır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The star system closest to the Sun. One of its three stars, Proxima, is the nearest star to us."
          }
        }
      }
    },
    "Hedef: %@ takımyıldızını tamamla" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goal: complete %@"
          }
        }
      }
    },
    "Hedef: %lld günlük seri" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goal: a %lld-day streak"
          }
        }
      }
    },
    "Hedef: toplam %lld saat odak" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Goal: %lld hour of focus in total"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Goal: %lld hours of focus in total"
                }
              }
            }
          }
        }
      }
    },
    "Herkül Kümesi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hercules Cluster"
          }
        }
      }
    },
    "Hiç telefona bakmadın, %%%lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phone untouched, +%lld%%"
          }
        }
      }
    },
    "Işık yolculuğunda Alfa Centauri'ye var" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reach Alpha Centauri on the Journey of Light"
          }
        }
      }
    },
    "Işık yolculuğunda Ülker'e var" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reach the Pleiades on the Journey of Light"
          }
        }
      }
    },
    "Jüpiter" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jupiter"
          }
        }
      }
    },
    "Kahverengi gürültü" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brown noise"
          }
        }
      }
    },
    "Karanlık bir gecede çıplak gözle bulanık bir leke gibi görünür, dürbünle bakınca çok daha belirginleşir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a dark night it shows to the naked eye as a hazy smudge, and through binoculars it comes into much clearer view."
          }
        }
      }
    },
    "Karanlık bir gökyüzünde dürbünle bulanık bir yıldız gibi görünür." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
