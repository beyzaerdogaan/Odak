    "Çoban" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boötes"
          }
        }
      }
    },
    "Çoban'ın kuzeyi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "northern Boötes"
          }
        }
      }
    },
    "Çıplak gözle altı ya da yedi yıldızı seçilebilir, dürbünle bakınca onlarcası görünür." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The naked eye picks out six or seven of its stars; binoculars reveal dozens."
          }
        }
      }
    },
    "Çıplak gözle görülebilen en uzak nesnelerden biri olan Andromeda Galaksisi bu takımyıldızda bulunur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Andromeda Galaxy, one of the most distant things the naked eye can see, lies in this constellation."
          }
        }
      }
    },
    "Ülker" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pleiades"
          }
        }
      }
    },
    "Ülker (Yedi Kız Kardeş) yıldız kümesi Boğa'nın sırtında durur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Pleiades star cluster, the Seven Sisters, rides on the Bull's back."
          }
        }
      }
    },
